rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidRole(role) {
      return role == 'admin' || role == 'member';
    }

    // Family Member Accounts - validated fields and roles
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isValidId(userId) 
        && request.resource.data.role is string 
        && isValidRole(request.resource.data.role)
        && request.resource.data.username is string;
      allow update: if isValidId(userId) 
        && request.resource.data.role is string 
        && isValidRole(request.resource.data.role);
      allow delete: if isValidId(userId);
    }

    // Family-wide General Settings
    match /familySettings/{settingId} {
      allow get, list: if true;
      allow write: if isValidId(settingId);
    }

    // Family Expenses - numeric amount validation
    match /expenses/{expenseId} {
      allow get, list: if true;
      allow create, update: if isValidId(expenseId) 
        && request.resource.data.amount is number 
        && request.resource.data.amount >= 0;
      allow delete: if isValidId(expenseId);
    }

    // Family Deposits - numeric amount validation
    match /deposits/{depositId} {
      allow get, list: if true;
      allow create, update: if isValidId(depositId) 
        && request.resource.data.amount is number 
        && request.resource.data.amount >= 0;
      allow delete: if isValidId(depositId);
    }

    // Expense Categories
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(categoryId);
    }

    // Payment Methods
    match /paymentMethods/{methodId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(methodId);
    }

    // Deposit Types
    match /depositTypes/{typeId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(typeId);
    }

    // Activity Logs - immutable audit trail
    match /activityLogs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // Default fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
